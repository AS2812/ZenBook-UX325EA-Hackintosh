+void XE::wrapTGLSetupDisplayTiming(void *fb, const void *src, void *out) {
+	// UX325EA: AppleIntelFramebuffer::setupDisplayTiming(src, out) asks the AGDC
+	// receiver (event 0xC) for a link mode. On "kAGDCRegisterLinkModesetCallback
+	// failed" / "invalid index" it returns before writing `out`, and setDisplayMode()
+	// passes that uninitialized stack buffer to hwSetMode(): garbage pixel clock and
+	// timings (computeLaneCount 0xE00002C7, SetupTimings divide error, wrong M/N).
+	// Its normal path is memmove(out, src, 0xA0); its override path writes 0xC..0x95.
+	// Prefill `out` with src so every path leaves a complete, valid timing.
+	auto s = callbackXE;
+	constexpr size_t size = 0xA0;
+	constexpr uint32_t marker = 0x57455846;
+	uint32_t head {};
+	if (src && out) {
+		memcpy(out, src, size);
+		memcpy(&head, src, sizeof(head));
+		memcpy(out, &marker, sizeof(marker));
+	}
+	auto b = static_cast<uint8_t *>(fb);
+	const int32_t before = b ? *reinterpret_cast<int32_t *>(b + 0x3FD8) : -2;
+	FunctionCast(wrapTGLSetupDisplayTiming, s->orgTGLSetupDisplayTiming)(fb, src, out);
+	if (!src || !out) return;
+	uint32_t now {};
+	memcpy(&now, out, sizeof(now));
+	const bool untouched = now == marker;
+	if (untouched) memcpy(out, &head, sizeof(head));
+	const bool same = !memcmp(out, src, size);
+	static uint32_t sequence {}, rescued {};
+	const auto seq = __sync_add_and_fetch(&sequence, 1);
+	if (untouched && same) __sync_add_and_fetch(&rescued, 1);
+	auto t = static_cast<const uint8_t *>(src);
+	uint64_t r[] {seq, untouched, same, rescued,
+		static_cast<uint64_t>(static_cast<int64_t>(before)),
+		static_cast<uint64_t>(static_cast<int64_t>(b ? *reinterpret_cast<int32_t *>(b + 0x3FD8) : -2)),
+		*reinterpret_cast<const uint64_t *>(t + 0x28), *reinterpret_cast<const uint32_t *>(t + 0x40),
+		*reinterpret_cast<const uint32_t *>(t + 0x50), b ? *reinterpret_cast<uint32_t *>(b + 0x1DC) : ~0U};
+	IORegistryEntry::getRegistryRoot()->setProperty("WEXTGLEDPTimingLast", r, sizeof(r));
+	if (seq <= 8) {
+		char key[40]; snprintf(key, sizeof(key), "WEXTGLEDPTimingFirst%u", seq);
+		IORegistryEntry::getRegistryRoot()->setProperty(key, r, sizeof(r));
+	}
+}
