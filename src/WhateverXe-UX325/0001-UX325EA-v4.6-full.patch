+// v4.6 (UX325EA): the console image is XRGB8888, but this OLED runs a 30-bit framebuffer
+// (ARGB2101010, also 32 bits per pixel). The raw copy showed the Apple-logo loading screen as
+// yellow / green noise at boot and at the login switch. Expand each channel to 10 bits.
+static inline uint32_t xeXRGB8888To2101010(uint32_t p) {
+	const uint32_t r = (p >> 16) & 0xFF, g = (p >> 8) & 0xFF, b = p & 0xFF;
+	return 0xC0000000U | ((r << 2 | r >> 6) << 20) | ((g << 2 | g >> 6) << 10) | (b << 2 | b >> 6);
+}
