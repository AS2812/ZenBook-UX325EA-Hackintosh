+uint32_t XE::wrapTGLHwSetBacklight(void *controller, uint32_t level) {
+	// UX325EA (Samsung ATNA33XC11 OLED): the donor drives only the PCH PWM duty (0xC8258)
+	// unless an Apple Camellia TCON is present. An OLED has no PWM backlight, so macOS
+	// brightness never reached the panel. Keep the native path, then set the panel's own
+	// brightness over DPCD:
+	//  - Intel HDR/OLED interface (DPCD 0x340: version, 0x341 bit4 nits cap, 0x342 bit0 SDR
+	//    AUX cap; 0x344 bit4 AUX enable; 0x354..0x357 = nits LSB/MSB, delay, steps), as
+	//    Linux intel_dp_aux_backlight.c. The firmware already programs Intel's source OUI.
+	//    Range 0..EDID max luminance (default 512 nits, as Linux).
+	//  - otherwise standard VESA eDP brightness (EDPAuxBacklight; PWMGEN bit count 0 means
+	//    the full 8/16-bit register range).
+	// Opt-in: -wex-tgl-edp-bl.
+	auto s = callbackXE;
+	const auto result = FunctionCast(wrapTGLHwSetBacklight, s->orgTGLHwSetBacklight)(controller, level);
+	auto port = s->tglEDPSinkPort;
+	if (!s->tglEDPBacklight || !port || !controller || level > 65535 || s->tglEDPBLState == 2) return result;
+	auto cfg = *reinterpret_cast<uint32_t **>(static_cast<uint8_t *>(port) + 0x548);
+	if (!cfg || cfg[2] != 0) return result;
+	// AUX to an unpowered eDP sink only times out: require PP_STATUS on.
+	auto access = *reinterpret_cast<void **>(static_cast<uint8_t *>(controller) + 0xC40);
+	const uint32_t pp = access && s->orgTGLRegisterRead ?
+		FunctionCast(wrapTGLRegisterRead, s->orgTGLRegisterRead)(access, 0xC7200) : UINT32_MAX;
+	static uint32_t calls {}, applied {}, failed {}, skipped {};
+	__sync_add_and_fetch(&calls, 1);
+	s->tglEDPBLWantLevel = level;
+	if (pp == UINT32_MAX || !(pp & 0x80000000U)) {
+		__sync_add_and_fetch(&skipped, 1);
+		s->tglEDPBLPending = (s->tglEDPBLState == 1 && s->tglEDPBLIface == 2);
+		uint64_t r[] {calls, applied, failed, skipped, level, pp, s->tglEDPBLState, 0, 0};
+		IORegistryEntry::getRegistryRoot()->setProperty("WEXTGLEDPBacklightLast", r, sizeof(r));
+		return result;
+	}
+	struct TGLEDPAUX {
+		void *port;
+		bool read(uint32_t a, void *p, uint32_t n) { return XE::wrapTGLReadAUX(port, a, p, n) == 0; }
+		bool write(uint32_t a, void *p, uint32_t n) { return XE::wrapTGLWriteAUX(port, a, p, n) == 0; }
