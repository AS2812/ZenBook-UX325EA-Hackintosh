+// Panel nits for a macOS backlight level (0..65535) on the Intel OLED interface.
+static uint32_t tglEDPBLNitsFor(uint32_t maxNits, uint32_t level) {
+	uint32_t written = uint32_t(uint64_t(level) * maxNits / 65535);
+	if (level && !written) written = 1;
+	// v4.1: keep about 0.5% of the panel maximum unless -wex-tgl-edp-bl-zero asks for
+	// MacBook-style "off at 0" (the UX325EA owner wants black at 0).
+	const uint32_t floorNits = maxNits / 200 ? maxNits / 200 : 1;
+	if (written < floorNits && !checkKernelArgument("-wex-tgl-edp-bl-zero")) written = floorNits;
+	return written;
+}
+
+// v4.3: lid open showed a black panel. macOS restores the brightness while waking; when that
+// write comes before the eDP panel is powered it is skipped (AUX to an unpowered sink only
+// times out) and the panel keeps the 0 nits written on lid close. Re-send the last requested
+// level as soon as the sink is powered (DPCD SET_POWER D0).
+void XE::tglEDPBLReapply(XE *s, void *port) {
+	const uint32_t level = s->tglEDPBLWantLevel;
+	const uint32_t written = tglEDPBLNitsFor(s->tglEDPBLMaxNits, level);
+	uint8_t ctrl = 0;
+	bool ok = XE::wrapTGLReadAUX(port, 0x344, &ctrl, 1) == 0;
+	if (ok && !(ctrl & 0x10)) { uint8_t want = uint8_t(ctrl | 0x10); ok = XE::wrapTGLWriteAUX(port, 0x344, &want, 1) == 0; }
+	uint8_t buf[4] {uint8_t(written), uint8_t(written >> 8), 0, 0};
+	ok = ok && XE::wrapTGLWriteAUX(port, 0x354, buf, sizeof(buf)) == 0;
+	if (ok) s->tglEDPBLPending = false;
+	SYSLOG("wex", "UX325 panel brightness re-sent after panel power-on: level %u -> %u nits (ok %d)", level, written, ok);
+	uint32_t r[] {level, written, ok};
+	IORegistryEntry::getRegistryRoot()->setProperty("WEXTGLEDPBacklightReapply", r, sizeof(r));
+}
+
+// v4.4: Shut Down / Restart showed green dots on a black screen: the eDP signal stops while the
+// OLED is still lit. Set the panel to 0 nits first (Intel interface), so it is plain black.
+IOReturn XE::tglEDPBLShutdown(void *, void *, UInt32 messageType, IOService *, void *, vm_size_t) {
+	auto s = callbackXE;
+	if ((messageType == kIOMessageSystemWillPowerOff || messageType == kIOMessageSystemWillRestart) &&
+	    s && s->tglEDPBacklight && s->tglEDPSinkPort && s->tglEDPBLState == 1 && s->tglEDPBLIface == 2) {
+		uint8_t buf[4] {};
+		const bool ok = XE::wrapTGLWriteAUX(s->tglEDPSinkPort, 0x354, buf, sizeof(buf)) == 0;
+		// v4.5: 0 nits alone still showed green dots - also put the panel to sleep (DPCD
+		// SET_POWER = D3), the standard eDP way to blank it before the link goes away.
+		uint8_t d3 = 0x02;
+		const bool off = XE::wrapTGLWriteAUX(s->tglEDPSinkPort, 0x600, &d3, 1) == 0;
+		SYSLOG("wex", "UX325 panel black before %s (nits %d, D3 %d)", messageType == kIOMessageSystemWillPowerOff ? "power off" : "restart", ok, off);
+	}
+	return kIOReturnSuccess;
+}
