 #include <crypto/sha1.h>
 #include <net80211/ieee80211_node.h>
 #include <net80211/ieee80211_ioctl.h>
+// ---- UX325EA patches (ZenBook-UX325EA-Hackintosh) -----------------------------------------
+// Rate-limited IOLog for XYLog: at most 40 lines per 10 s reach the macOS log.
+extern "C" int xy_iolog_ok(void)
+{
+    static uint64_t windowStart;
+    static int count;
+    uint64_t ns;
+    uint64_t abst; clock_get_uptime(&abst); absolutetime_to_nanoseconds(abst, &ns);
+    if (ns - windowStart > 10ULL * 1000000000ULL) { windowStart = ns; count = 0; }
+    return ++count <= 40;
+}
+// Newer clang lowers memset(0) to __bzero, which the official 2.3.0 build never imported from the
+// kernel. Provide it privately (rep stosb cannot be turned back into a __bzero call).
+extern "C" __attribute__((visibility("hidden"))) void __bzero(void *s, size_t n)
+{
+    __asm__ volatile("rep stosb" : "+D"(s), "+c"(n) : "a"(0) : "memory");
+}
